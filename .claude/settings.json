{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/key.properties)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/build/**)",
      "Read(**/dist/**)",
      "Read(**/node_modules/**)",
      "Read(**/vendor/**)",
      "Read(**/coverage/**)",
      "Read(**/.next/**)",
      "Read(**/.venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.dart_tool/**)",
      "Read(**/*.g.dart)",
      "Read(**/*.lock)",
      "Read(**/package-lock.json)",
      "Read(**/*.min.js)",
      "Read(**/*.min.css)",
      "Read(**/*.map)"
    ],
    "ask": [
      "Read(**/*.pdf)",
      "Read(**/*.heic)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/helper/guard_paths.py\"",
            "timeout": 10,
            "statusMessage": "Guarding paths"
          }
        ]
      }
    ]
  }
}
